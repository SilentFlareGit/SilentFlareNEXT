---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import PostLightbox from "@components/PostLightbox.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import {
	absoluteUrl,
	blogPostingJsonLd,
	breadcrumbJsonLd,
	seoAuthor,
} from "@lib/seo";
import { getSiteSettings } from "@lib/site-settings";
import { getSortedPosts } from "@utils/content-utils";
import { getPostUrlBySlug } from "@utils/url-utils";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import { licenseConfig, siteConfig } from "src/config";
import CommentSection from "../../components/comments/CommentSection.svelte";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

function stripHtml(html: string): string {
	return html.replace(/<[^>]*>/g, "").trim();
}

function extractHeadings(html: string): MarkdownHeading[] {
	const headings: MarkdownHeading[] = [];
	const headingPattern = /<h([2-3])(?:\s+[^>]*)?>(.*?)<\/h\1>/gi;
	for (const match of html.matchAll(headingPattern)) {
		const depth = Number(match[1]);
		const raw = match[0];
		const id = raw.match(/\sid=["']([^"']+)["']/i)?.[1];
		if (!id) continue;
		headings.push({
			depth,
			slug: id,
			text: stripHtml(match[2]),
		});
	}
	return headings;
}

const { entry } = Astro.props;
const headings = extractHeadings(entry.html);
const site = Astro.site ?? new URL("https://blog.silentflare.com/");
const settings = await getSiteSettings();
const postUrl = absoluteUrl(`/posts/${entry.slug}/`, site);
const canonicalUrl = absoluteUrl(entry.canonicalUrl || postUrl, site);
const breadcrumbItems = [
	{ name: "Home", url: absoluteUrl("/", site) },
	...(entry.primaryTag
		? [
				{
					name: entry.primaryTag.name,
					url: absoluteUrl(`/tags/${entry.primaryTag.slug}/`, site),
				},
			]
		: []),
	{ name: entry.title, url: postUrl },
];
const socialImage = entry.ogImage || entry.twitterImage || entry.featureImage;
const articleJsonLd = blogPostingJsonLd(entry, site, {
	name: settings.name || siteConfig.title,
	logoUrl: absoluteUrl("/favicon/favicon-dark-192.png", site),
});
const seo = {
	title: entry.metaTitle ?? entry.title,
	description: entry.metaDescription ?? entry.excerpt,
	canonicalUrl,
	type: "article" as const,
	image: socialImage
		? {
				url: socialImage,
				alt: entry.featureImageAlt || entry.title,
				width: 1600,
				height: 900,
			}
		: undefined,
	ogTitle: entry.ogTitle,
	ogDescription: entry.ogDescription,
	twitterTitle: entry.twitterTitle,
	twitterDescription: entry.twitterDescription,
	publishedTime: entry.published.toISOString(),
	modifiedTime: (entry.updated ?? entry.published).toISOString(),
	authors: entry.authors.map((author) => seoAuthor(author, site)),
	tags: entry.tags.map((tag) => tag.name),
	jsonLd: [articleJsonLd, breadcrumbJsonLd(breadcrumbItems)],
};
---
<MainGridLayout banner={entry.featureImage} title={entry.metaTitle ?? entry.title} description={entry.metaDescription ?? entry.excerpt} setOGTypeArticle={true} headings={headings} {seo}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="post-container" class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
            <Breadcrumbs items={breadcrumbItems} class="mb-4 onload-animation" />
            <div class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="text-sm">
                        {entry.readingTime} {" " + i18n(entry.readingTime === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
            </div>

            <div class="relative onload-animation">
                <h1
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]
                ">
                    {entry.title}
                </h1>
            </div>

            <div class="onload-animation">
                <PostMetadata
                        class="mb-5"
                        published={entry.published}
                        updated={entry.updated}
                        tags={entry.tags}
                        category={entry.primaryTag}
                        authors={entry.authors}
                ></PostMetadata>
                {!entry.featureImage && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
            </div>

            {entry.featureImage && (
                <figure class="mb-8 onload-animation">
                    <ImageWrapper id="post-cover" src={entry.featureImage} alt={entry.featureImageAlt || `Cover image for ${entry.title}`} width={1600} height={900} sizes="(min-width: 1024px) 48rem, calc(100vw - 3rem)" priority class="rounded-xl aspect-[16/9] w-full"/>
                    {entry.featureImageCaption && <figcaption class="mt-2 text-center text-sm text-50">{stripHtml(entry.featureImageCaption)}</figcaption>}
                </figure>
            )}

            <Markdown class="mb-6 markdown-content onload-animation">
                <Fragment set:html={entry.html} />
            </Markdown>

            {licenseConfig.enable && <License title={entry.title} slug={entry.slug} pubDate={entry.published} class="mb-6 rounded-xl license-container onload-animation"></License>}

        </div>
    </div>

    <div id="discussion">
        <CommentSection client:visible postSlug={entry.slug}></CommentSection>
    </div>

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        {entry.nextSlug && <a href={getPostUrlBySlug(entry.nextSlug)}
           class="w-full font-bold overflow-hidden active:scale-95">
            <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-start gap-4" >
                <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.nextTitle}
                </div>
            </div>
        </a>}

        {entry.prevSlug && <a href={getPostUrlBySlug(entry.prevSlug)}
           class="w-full font-bold overflow-hidden active:scale-95">
            <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-end gap-4">
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)]" />
            </div>
        </a>}
    </div>

    <PostLightbox />
</MainGridLayout>
