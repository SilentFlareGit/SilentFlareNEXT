---
import type { GetStaticPaths } from "astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Pagination from "../../../components/control/Pagination.astro";
import PostPage from "../../../components/PostPage.astro";
import { PAGE_SIZE } from "../../../constants/constants";
import MainGridLayout from "../../../layouts/MainGridLayout.astro";
import {
	absoluteUrl,
	breadcrumbJsonLd,
	isIndexableCollection,
} from "../../../lib/seo";
import { getPostsForTag, getTagList } from "../../../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const tags = await getTagList();
	const paths = [];
	for (const tag of tags) {
		const posts = await getPostsForTag(tag.slug);
		paths.push(
			...paginate(posts, {
				pageSize: PAGE_SIZE,
				params: { tag: tag.slug },
				props: { tag },
			}),
		);
	}
	return paths;
}) satisfies GetStaticPaths;

const { page, tag } = Astro.props;
const len = page.data.length;
const description =
	tag.metaDescription ?? tag.description ?? `Posts tagged ${tag.name}`;
const site = Astro.site ?? new URL("https://blog.silentflare.com/");
const tagUrl = absoluteUrl(`/tags/${tag.slug}/`, site);
const title = `${tag.metaTitle ?? tag.name}${page.currentPage > 1 ? ` - Page ${page.currentPage}` : ""}`;
const breadcrumbItems = [
	{ name: "Home", url: absoluteUrl("/", site) },
	{ name: `Tag: ${tag.name}`, url: tagUrl },
];
const collectionJsonLd = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: title,
	description,
	url: new URL(Astro.url.pathname, site).toString(),
	mainEntity: {
		"@type": "ItemList",
		itemListElement: page.data.map((post, index) => ({
			"@type": "ListItem",
			position: index + 1,
			url: absoluteUrl(`/posts/${post.slug}/`, site),
			name: post.title,
		})),
	},
};
---

<MainGridLayout title={title} description={description} seo={{
	noindex: !isIndexableCollection(tag),
	image: tag.featureImage ? { url: tag.featureImage, alt: `${tag.name} tag` } : undefined,
	jsonLd: [breadcrumbJsonLd(breadcrumbItems), collectionJsonLd],
}}>
    <header class="card-base mb-4 px-6 py-6 md:px-9">
        <Breadcrumbs items={breadcrumbItems} class="mb-4" />
        <h1 class="text-3xl font-bold text-90">{tag.name}</h1>
        <p class="mt-2 text-75">{description}</p>
    </header>
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} basePath={`/tags/${tag.slug}/`} style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}></Pagination>
</MainGridLayout>
