---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { absoluteUrl, breadcrumbJsonLd } from "@lib/seo";
import { getSortedPostsList } from "../utils/content-utils";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getPostUrlBySlug } from "../utils/url-utils";

const sortedPostsList = await getSortedPostsList();
const groupedPosts = Object.entries(
	sortedPostsList.reduce(
		(groups, post) => {
			const year = String(post.published.getFullYear());
			groups[year] = groups[year] ?? [];
			groups[year].push(post);
			return groups;
		},
		{} as Record<string, typeof sortedPostsList>,
	),
).sort(([yearA], [yearB]) => Number(yearB) - Number(yearA));
const site = Astro.site ?? new URL("https://blog.silentflare.com/");
const archiveUrl = absoluteUrl("/archive/", site);
const breadcrumbItems = [
	{ name: "Home", url: absoluteUrl("/", site) },
	{ name: "Archive", url: archiveUrl },
];
const archiveJsonLd = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: "SilentFlare archive",
	description: "Browse every published SilentFlare article by year.",
	url: archiveUrl,
	mainEntity: {
		"@type": "ItemList",
		itemListElement: sortedPostsList.map((post, index) => ({
			"@type": "ListItem",
			position: index + 1,
			url: absoluteUrl(getPostUrlBySlug(post.slug), site),
			name: post.title,
		})),
	},
};
---

<MainGridLayout title={i18n(I18nKey.archive)} description="Browse every published SilentFlare article by year." seo={{ jsonLd: [breadcrumbJsonLd(breadcrumbItems), archiveJsonLd] }}>
    <div class="card-base px-8 py-6">
        <header class="mb-5">
            <Breadcrumbs items={breadcrumbItems} class="mb-4" />
            <h1 class="text-3xl font-bold text-90">{i18n(I18nKey.archive)}</h1>
            <p class="mt-2 text-75">Browse every published SilentFlare article by year.</p>
        </header>
        {groupedPosts.map(([year, posts]) => (
            <section>
                <div class="flex flex-row w-full items-center h-[3.75rem]">
                    <h2 class="w-[15%] md:w-[10%] transition text-2xl font-bold text-right text-75">
                        {year}
                    </h2>
                    <div class="w-[15%] md:w-[10%]">
                        <div class="h-3 w-3 bg-none rounded-full outline outline-[var(--primary)] mx-auto -outline-offset-[2px] z-50 outline-3"></div>
                    </div>
                    <div class="w-[70%] md:w-[80%] transition text-left text-50">
                        {posts.length} {i18n(posts.length === 1 ? I18nKey.postCount : I18nKey.postsCount)}
                    </div>
                </div>
                {posts.map((post) => (
                    <a href={getPostUrlBySlug(post.slug)} aria-label={post.title} class="group btn-plain !block h-10 w-full rounded-lg hover:text-[initial]">
                        <div class="flex flex-row justify-start items-center h-full">
                            <div class="w-[15%] md:w-[10%] transition text-sm text-right text-50">
                                {formatDateToYYYYMMDD(post.published).slice(5)}
                            </div>
                            <div class="w-[15%] md:w-[10%] relative dash-line h-full flex items-center">
                                <div class="transition-all mx-auto w-1 h-1 rounded group-hover:h-5 bg-[oklch(0.5_0.05_var(--hue))] group-hover:bg-[var(--primary)] outline outline-4 z-50 outline-[var(--card-bg)] group-hover:outline-[var(--btn-plain-bg-hover)] group-active:outline-[var(--btn-plain-bg-active)]"></div>
                            </div>
                            <div class="w-[70%] md:max-w-[65%] md:w-[65%] text-left font-bold group-hover:translate-x-1 transition-all group-hover:text-[var(--primary)] text-75 pr-8 whitespace-nowrap overflow-ellipsis overflow-hidden">
                                {post.title}
                            </div>
                            <div class="hidden md:block md:w-[15%] text-left text-sm transition whitespace-nowrap overflow-ellipsis overflow-hidden text-30">
                                {post.tags.map((tag) => `#${tag.name}`).join(" ")}
                            </div>
                        </div>
                    </a>
                ))}
            </section>
        ))}
    </div>
</MainGridLayout>
