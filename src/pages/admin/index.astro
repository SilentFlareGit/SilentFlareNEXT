---
import defaultAvatar from "../../assets/images/demo-avatar.png";
import defaultBanner from "../../assets/images/demo-banner-online.webp";
import AdminApp from "../../components/admin/AdminApp.svelte";
import SubsiteLayout from "../../layouts/SubsiteLayout.astro";

const apiBase = "/admin-api";
const fallbackAssets = {
	avatar: defaultAvatar.src,
	banner: defaultBanner.src,
};
---

<SubsiteLayout title="SilentFlare Admin" description="SilentFlare owner console for public users and comments." theme="light">
	<div class="sr-only" aria-hidden="true">SilentFlare user and comment control public users and comments</div>
	<AdminApp client:only="svelte" {apiBase} {fallbackAssets} />
</SubsiteLayout>
