<script>
import MarkdownIt from "markdown-it";

type Background = {
	id: string;
	type: "image" | "video";
	url: string;
	position?: string;
};
type SiteSettings = {
	name: string;
	bio: string;
	avatar_url: string;
	about_markdown: string;
	backgrounds: Background[];
	updated_at?: string | null;
};

const API = "https://api.silentflare.com/site/settings";
const markdown = new MarkdownIt({ html: false, linkify: true, typographer: true });
let rotationTimer: number | undefined;

function safeHtml(source: string) {
	const template = document.createElement("template");
	template.innerHTML = markdown.render(source);
	for (const element of template.content.querySelectorAll("*")) {
		for (const attribute of [...element.attributes]) {
			if (attribute.name.startsWith("on")) element.removeAttribute(attribute.name);
		}
		if (element instanceof HTMLAnchorElement) {
			const parsed = new URL(element.href, window.location.origin);
			if (!['http:', 'https:', 'mailto:'].includes(parsed.protocol)) element.removeAttribute("href");
			element.rel = "noopener noreferrer";
		}
	}
	return template.innerHTML;
}

function applyContent(settings: SiteSettings) {
	if (!settings.updated_at) return;
	const isLegacyAsset = (value: string) => value.startsWith("/assets/images/");
	document.querySelectorAll<HTMLElement>("[data-site-name]").forEach((node) => { node.textContent = settings.name; });
	document.querySelectorAll<HTMLElement>("[data-site-bio]").forEach((node) => { node.textContent = settings.bio; });
	document.querySelectorAll<HTMLElement>("[data-site-avatar]").forEach((node) => {
		const image = node instanceof HTMLImageElement ? node : node.querySelector("img");
		if (image && !isLegacyAsset(settings.avatar_url)) image.src = settings.avatar_url;
	});
	const about = document.querySelector<HTMLElement>("[data-site-about]");
	if (about && settings.about_markdown) about.innerHTML = safeHtml(settings.about_markdown);
	document.querySelectorAll<HTMLElement>("[data-site-profile]").forEach((profile) => {
		profile.classList.remove("site-profile-pending");
	});
}

async function applyBanner(settings: SiteSettings) {
	if (!settings.updated_at) return;
	const isLegacyAsset = (value: string) => value.startsWith("/assets/images/");
	const wrapper = document.querySelector<HTMLElement>("#banner-wrapper");
	if (!wrapper || !settings.backgrounds?.length) return;
	const usableBackgrounds = settings.backgrounds.filter((background) => !isLegacyAsset(background.url));
	if (!usableBackgrounds.length) return;
	let active = 0;
	const layers = usableBackgrounds.map((background, index) => {
		const media = document.createElement(background.type === "video" ? "video" : "img");
		media.className = "site-background-layer";
		media.style.objectPosition = background.position || "center";
		media.setAttribute("aria-hidden", "true");
		if (media instanceof HTMLVideoElement) {
			media.src = background.url;
			media.autoplay = true;
			media.muted = true;
			media.loop = true;
			media.playsInline = true;
		} else {
			media.src = background.url;
			media.alt = "";
		}
		media.classList.toggle("is-active", index === 0);
		wrapper.append(media);
		return media;
	});
	const firstLayer = layers[0];
	const firstLayerReady = firstLayer instanceof HTMLImageElement
		? firstLayer.complete
		: firstLayer instanceof HTMLVideoElement && firstLayer.readyState >= 2;
	if (firstLayer && !firstLayerReady) {
		await new Promise<void>((resolve) => {
			const done = () => resolve();
			firstLayer.addEventListener("load", done, { once: true });
			firstLayer.addEventListener("canplay", done, { once: true });
			firstLayer.addEventListener("error", done, { once: true });
		});
	}
	wrapper.querySelector("#banner")?.remove();
	document.querySelector<HTMLElement>("#banner-credit")?.remove();
	if (rotationTimer) window.clearInterval(rotationTimer);
	if (layers.length > 1) rotationTimer = window.setInterval(() => {
		layers[active]?.classList.remove("is-active");
		active = (active + 1) % layers.length;
		layers[active]?.classList.add("is-active");
	}, 9000);
}

async function load(includeBanner = false) {
	try {
		const response = await fetch(API, {
			cache: "no-store",
			headers: { Accept: "application/json" },
		});
		if (!response.ok) return;
		const body = await response.json();
		const settings = body.settings as SiteSettings;
		applyContent(settings);
		if (includeBanner) void applyBanner(settings);
	} catch (error) {
		console.warn("Site customization could not be loaded.", error);
		const about = document.querySelector<HTMLElement>("[data-site-about]");
		if (about) about.innerHTML = "<p>About content is temporarily unavailable.</p>";
	} finally {
		document.querySelectorAll<HTMLElement>("[data-site-profile]").forEach((profile) => {
			profile.classList.remove("site-profile-pending");
		});
	}
}

void load(true);
const setupSwup = () => {
	window.swup.hooks.on("page:view", () => {
		void load();
	});
};
if (window.swup?.hooks) setupSwup();
else document.addEventListener("swup:enable", setupSwup, { once: true });
</script>

<style is:global>
	.site-profile-pending { visibility:hidden; }
	.site-about-loading { display:grid; gap:.8rem; padding:.5rem 0; }
	.site-about-loading span { display:block; height:1rem; border-radius:4px; background:linear-gradient(90deg, #e7eef4 25%, #f5f8fa 50%, #e7eef4 75%); background-size:200% 100%; animation:site-loading 1.2s ease-in-out infinite; }
	.site-about-loading span:first-child { width:42%; height:1.75rem; }
	.site-about-loading span:last-child { width:68%; }
	.site-background-layer { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0; transform:scale(1.025); transition:opacity 1.2s ease, transform 9s ease; }
	.site-background-layer.is-active { opacity:1; transform:scale(1); }
	@keyframes site-loading { to { background-position:-200% 0; } }
	@media (prefers-reduced-motion: reduce) { .site-background-layer { transition:none; } .site-about-loading span { animation:none; } }
</style>
