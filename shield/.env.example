# Runtime mode: bypass, observe, or enforce. Start production rollout in observe.
SHIELD_MODE=observe
# open, closed, or route. route fails open for public reads and closed for sensitive requests.
SHIELD_FAIL_POLICY=route
SHIELD_DATABASE_PATH=/app/data/shield.db

# Generate an independent random value of at least 32 bytes. Never reuse account session secrets.
SHIELD_INTERNAL_SIGNING_KEY=<generate-a-random-64-character-secret>

# Shield delegates console access to the existing SilentFlare Admin session.
SHIELD_ADMIN_INTROSPECTION_URL=http://host.docker.internal:9010/auth/me
SHIELD_ADMIN_COOKIE_NAME=sf_bot_session
SHIELD_ACCOUNT_SNAPSHOT_URL=http://host.docker.internal:9010/internal/shield/accounts
SHIELD_ACCOUNT_SYNC_INTERVAL=60
SHIELD_SYNC_SECRET=<generate-a-random-64-character-secret-shared-only-with-fastapi>
SHIELD_COOKIE_SECURE=true

# Cloudflare Turnstile credentials dedicated to Shield.
SHIELD_TURNSTILE_SITE_KEY=<turnstile-site-key>
SHIELD_TURNSTILE_SECRET_KEY=<turnstile-secret-key>
SHIELD_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Prefer Cloudflare location headers. The provider is a cache-backed enrichment fallback.
SHIELD_GEO_URL_TEMPLATE=https://ipwho.is/{ip}
SHIELD_GEO_CACHE_TTL=86400
SHIELD_ALLOW_PRIVATE_GEO=false

# Only these direct peers may supply client-IP forwarding headers.
SHIELD_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
SHIELD_PROXY_TIMEOUT_SECONDS=10
SHIELD_MAX_BODY_BYTES=4194304

# Map each public Host header to an origin. Do not point an origin back to Shield.
SHIELD_UPSTREAMS_JSON={"blog.silentflare.com":"http://host.docker.internal:4321","accounts.silentflare.com":"http://host.docker.internal:4321","api.silentflare.com":"http://host.docker.internal:9010","admin.silentflare.com":"http://host.docker.internal:4321","cms.silentflare.com":"http://host.docker.internal:2368"}
